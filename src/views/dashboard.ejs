<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:sans-serif; }

        body {
            display:flex;
            height:100vh;
            background:#0f172a;
            color:white;
        }

        .sidebar {
            width:220px;
            background:#1e293b;
            padding:20px;
        }

        .sidebar h2 {
            margin-bottom:20px;
        }

        .sidebar a {
            display:block;
            margin:10px 0;
            color:white;
            text-decoration:none;
        }

        .sidebar a:hover {
            color:#6366f1;
        }

        .main {
            flex:1;
            padding:20px;
        }

        .cards {
            display:flex;
            gap:20px;
            margin:20px 0;
        }

        .card {
            background:#1e293b;
            padding:20px;
            border-radius:10px;
            flex:1;
            text-align:center;
        }

        .box {
            background:#1e293b;
            padding:20px;
            border-radius:10px;
            margin-top:20px;
        }

        input, button {
            width:100%;
            padding:10px;
            margin:8px 0;
            border:none;
            border-radius:5px;
        }

        button {
            background:#6366f1;
            color:white;
        }

    </style>
</head>

<body>

<div class="sidebar">
    <h2>AI Tracker</h2>
    <a href="/dashboard">Dashboard</a>
    <a href="/analytics">Analytics</a>
    <a href="/history">History</a>
    <a href="/profile">Profile</a>
    <a href="/logout">Logout</a>
</div>

<div class="main">

    <h2>Welcome <%= user.name %></h2>

    <div class="cards">
        <div class="card">
            <h3>Total Time</h3>
            <p><%= totalTime %> mins</p>
        </div>

        <div class="card">
            <h3>Sessions</h3>
            <p><%= sessionsCount %></p>
        </div>
    </div>

    <div class="box">
        <h3>Add Session</h3>

        <form action="/add-session" method="POST">
            <input name="subject" placeholder="Subject" required>
            <input name="duration" placeholder="Minutes" required>
            <button>Add Session</button>
        </form>
    </div>

    <div class="box">
        <h3>History</h3>

        <ul>
            <% sessions.forEach(s => { %>
                <li><%= s.subject %> - <%= s.duration %> mins</li>
            <% }) %>
        </ul>
    </div>

    <div class="box">
        <h3>AI Recommendation</h3>
        <p><%= recommendation %></p>
    </div>

    <div class="box">
        <canvas id="chart"></canvas>
    </div>

</div>

<script>
    const data = JSON.parse('<%- JSON.stringify(sessions.map(s => s.duration)) %>');

    new Chart(document.getElementById("chart"), {
        type: "bar",
        data: {
            labels: data.map((_, i) => "Session " + (i + 1)),
            datasets: [{
                label: "Study Time",
                data: data
            }]
        }
    });
</script>

</body>
</html>